<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Margin="30,30,30,0"
                VerticalAlignment="Top"
                Height="302"
                Background="#3E5454"
                CornerRadius="5">
            <StackPanel Margin="32,31,32,25">
                <TextBlock Text="NEWS"
                           Foreground="#FFC809"
                           FontWeight="Bold"
                           FontSize="13" />
                <TextBlock Text="Welcome back to the Isles"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="30"
                           Margin="0,7,0,12" />
                <TextBlock Text="This is an example post from index.xaml. The launcher shows this page in the panel above the login buttons, and moves to the next post every 15 seconds."
                           Foreground="#EDF3F0"
                           FontSize="16"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
